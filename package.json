{
  "name": "@chonwai/dsh-rein",
  "version": "2.0.0",
  "private": true,
  "description": "Rein \u2014 Ponytail for DeepSeek Harness (formerly @chonwai/dsh-ponytail): six skills, a scoped always-on ruleset, and a composer-dock pill. Verified, reversible, MIT, no runtime dependencies.",
  "license": "MIT",
  "author": "Chonwai",
  "homepage": "https://github.com/Chonwai/dsh-rein#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chonwai/dsh-rein.git"
  },
  "bugs": {
    "url": "https://github.com/Chonwai/dsh-rein/issues"
  },
  "keywords": [
    "rein",
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "ponytail",
    "skills",
    "ai-agent",
    "deepseek",
    "dsh-plugin",
    "dsh-ponytail",
    "agent-skills",
    "lazy",
    "yagni",
    "code-review",
    "over-engineering"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bash tests/offline-check.sh",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check tests/host-smoke.mjs && node --check tests/client-smoke.mjs && bash -n tools/check-release.sh",
    "smoke": "node tests/host-smoke.mjs && node tests/client-smoke.mjs",
    "test:consumer": "bash tests/consumer-smoke.sh",
    "release:check": "bash tools/check-release.sh"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/**/*.js",
    "skills",
    "rules.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-TW.md",
    "INSTALL.md",
    "docs",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "checksums.txt",
    "tests",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
